@startuml Support_DatabaseDiagram
!include style.iuml
skinparam linetype ortho
title MindFlow - Support - Database Diagram (MySQL 8)

entity "support_tickets" as support_tickets {
  * id : int <<PK>>
  --
  * owner_id : int <<logical FK users.id>>
  assignee_id : int, nullable <<logical FK users.id>>
  * subject : varchar(200)
  * category : varchar(50)
  * priority : varchar(20)
  * status : varchar(20)
  created_at : datetime, nullable
  updated_at : datetime, nullable
  --
  INDEX (owner_id, status)
}
entity "support_messages" as support_messages {
  * id : int <<PK>>
  --
  * ticket_id : int <<FK ON DELETE CASCADE>>
  * author_id : int <<logical FK users.id>>
  * is_staff : boolean
  * body : text
  created_at : datetime, nullable
  updated_at : datetime, nullable
}
support_tickets ||--|{ support_messages : "has thread"
@enduml
