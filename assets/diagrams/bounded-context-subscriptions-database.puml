@startuml Subscriptions_DatabaseDiagram
!include style.iuml
skinparam linetype ortho
title MindFlow - Subscriptions - Database Diagram (MySQL 8)

entity "subscriptions" as subscriptions {
  * id : int <<PK>>
  --
  * user_id : int <<logical FK users.id, UNIQUE>>
  * plan : varchar(30)
  * status : varchar(30)
  stripe_customer_id : varchar(255), nullable
  stripe_subscription_id : varchar(255), nullable
  current_period_end : datetime, nullable
  created_at : datetime, nullable
  updated_at : datetime, nullable
}
note right of subscriptions
  One row per user (unique index on user_id; no real
  foreign key to users). plan: freemium | premium
  (default values are set in the application code).
end note
@enduml
