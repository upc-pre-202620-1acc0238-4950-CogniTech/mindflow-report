@startuml Support_DomainLayer_ClassDiagram
!include style.iuml
title MindFlow - Support - Domain Layer Class Diagram

interface IAuditableEntity {
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
class SupportTicket <<Aggregate Root>> {
  +Id : int
  +OwnerId : int
  +AssigneeId : int?
  +Subject : string
  +Category : string = "general"
  +Priority : string = "normal"
  +Status : string = "open"
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
class SupportMessage <<Entity>> {
  +Id : int
  +TicketId : int
  +AuthorId : int
  +IsStaff : bool
  +Body : string
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
class SupportTicketsController <<REST Controller>> {
  +Create(...) : IActionResult
  +List() : IActionResult
  +Get(id: int) : IActionResult
  +AddMessage(id: int, ...) : IActionResult
  +Update(id: int, assigneeId: int?, status: string) : IActionResult
}

SupportTicket ..|> IAuditableEntity : implements
SupportMessage ..|> IAuditableEntity : implements
SupportTicket "1" *-- "0..*" SupportMessage : "has thread >"
SupportTicketsController ..> SupportTicket : "manages >"

note right of SupportTicket
  OwnerId and AssigneeId are logical references to IAM users.
  Status, Category and Priority are free strings (no enum):
  "open" by default; PATCH accepts any value.
  There is no dedicated "resolve" operation.
end note
note bottom of SupportTicketsController
  Only PATCH requires the Support or Admin role.
  Creating a ticket notifies its owner; a staff reply
  notifies the owner (through Notifications).
end note
@enduml
