@startuml HabitsWellness_DatabaseDiagram
!include style.iuml
skinparam linetype ortho
title MindFlow - Habits & Wellness - Database Diagram (MySQL 8)

entity "habits" as habits {
  * id : int <<PK>>
  --
  * user_id : int <<logical FK users.id>>
  * name : varchar(200)
  * category : varchar(100)
  * frequency : varchar(20) <<Daily | Weekly | Monthly>>
  * streak : int = 0
  * status : varchar(20) <<Pending | Completed | PausedByAi>>
  * paused_by_ai : boolean = false
  created_at : datetime, nullable
  updated_at : datetime, nullable
  deleted_at : datetime, nullable <<not used by the delete flow>>
  --
  INDEX (user_id), INDEX (user_id, status)
}
entity "habit_completion_logs" as habit_completion_logs {
  * id : int <<PK>>
  --
  * habit_id : int <<FK ON DELETE CASCADE>>
  * habit_name : varchar(200)
  * category : varchar(100)
  * date : datetime(6)
  * completed : boolean = true
  completed_at : datetime(6), nullable
  * created_at : datetime
  --
  INDEX (date), INDEX (habit_id), INDEX (habit_id, date)
}
entity "cached_habit_suggestions" as cached_habit_suggestions {
  * id : int <<PK>>
  --
  * user_id : int <<logical FK users.id, UNIQUE>>
  * suggestions_json : text (JSON)
  * generated_at : datetime
}
entity "wellness_exercises" as wellness_exercises {
  * id : int <<PK>>
  --
  * type : varchar(20) <<breathing | meditation>>
  * name : varchar(200)
  * description : varchar(1000)
  * duration_seconds : int
  inhale_seconds : int, nullable
  hold_seconds : int, nullable
  exhale_seconds : int, nullable
  hold_after_exhale_seconds : int, nullable
  cycles : int, nullable
  audio_url : varchar(500), nullable
  * is_active : boolean
  * sort_order : int
  created_at : datetime, nullable
  updated_at : datetime, nullable
  --
  INDEX (type, is_active)
}
habits ||--o{ habit_completion_logs : "is completed through"
note bottom of habit_completion_logs
  (habit_id, date) is indexed but not unique.
end note
@enduml
