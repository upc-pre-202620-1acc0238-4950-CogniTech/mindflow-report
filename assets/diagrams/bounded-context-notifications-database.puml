@startuml Notifications_DatabaseDiagram
!include style.iuml
skinparam linetype ortho
title MindFlow - Notifications - Database Diagram (MySQL 8)

entity "notifications" as notifications {
  * id : int <<PK>>
  --
  * user_id : int <<logical FK users.id>>
  * type : varchar(50)
  * title : varchar(200)
  * body : varchar(2000)
  read_at : datetime, nullable <<null = unread>>
  created_at : datetime, nullable
  updated_at : datetime, nullable
  --
  INDEX (user_id, read_at)
}
entity "device_tokens (planned)" as device_tokens #EEEEEE {
  * id : int <<PK>>
  --
  * user_id : int
  * token : varchar
  * platform : varchar
}
note bottom of device_tokens
  Not created: there is no push delivery yet.
end note
@enduml
