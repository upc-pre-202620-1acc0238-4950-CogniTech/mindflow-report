@startuml IAM_DomainLayer_ClassDiagram
!include style.iuml
title MindFlow - IAM - Domain Layer Class Diagram

interface IAuditableEntity {
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
interface "IBaseRepository<TEntity>" as IBaseRepository {
  +AddAsync(entity: TEntity, ct: CancellationToken) : Task
  +FindByIdAsync(id: int, ct: CancellationToken) : Task<TEntity?>
  +Update(entity: TEntity) : void
  +Remove(entity: TEntity) : void
  +ListAsync(ct: CancellationToken) : Task<IEnumerable<TEntity>>
}
class User <<Aggregate Root>> {
  -Id : int
  -Email : string
  -Name : string?
  -Occupation : string?
  -GoogleId : string?
  -PasswordHash : string
  -PinHash : string?
  -Role : string
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
  +{static} AdminRole : string = "Admin"
  +{static} SupportRole : string = "Support"
  +{static} DefaultRole : string = "User"
  +IsAdmin : bool
  +HasPin : bool
  +User(email: string, password: string)
  +User(email: string, googleId: string, name: string?)
  +PromoteToAdmin() : User
  +PromoteToSupport() : User
  +LinkGoogle(googleId: string) : void
  +UpdatePasswordHash(password: string) : User
  +UpdateProfile(name: string?, occupation: string?) : User
  +SetPin(pin: string) : User
  +VerifyPin(pin: string) : bool
  +RemovePin() : User
}
class PasswordResetToken <<Entity>> {
  +Id : int
  +UserId : int
  +Token : string
  +ExpiresAt : DateTime
  +Used : bool
}
interface IUserRepository {
  +FindByEmailAsync(email: string) : Task<User?>
  +FindByGoogleIdAsync(googleId: string) : Task<User?>
  +ExistsByEmailAsync(email: string) : Task<bool>
}
package "Commands (domain/model/commands)" <<Rectangle>> {
class SignUpCommand <<record>> {
  +Email : string
  +Password : string
  +Name : string?
}
class SignInCommand <<record>> {
  +Email : string
  +Password : string
}
class GoogleAuthCommand <<record>> {
  +Credential : string
}
class UpdateProfileCommand <<record>> {
  +UserId : int
  +Name : string?
  +Occupation : string?
}
class ForgotPasswordCommand <<record>> {
  +Email : string
}
class ResetPasswordCommand <<record>> {
  +Token : string
  +NewPassword : string
}
class SetPinCommand <<record>> {
  +UserId : int
  +Pin : string
}
class VerifyPinCommand <<record>> {
  +UserId : int
  +Pin : string
}
class RemovePinCommand <<record>> {
  +UserId : int
}
class DeleteAccountCommand <<record>> {
  +UserId : int
}

}

User ..|> IAuditableEntity : implements
IUserRepository --|> IBaseRepository : extends
IUserRepository ..> User : "manages >"
PasswordResetToken "0..*" --> "1" User : "belongs to >"

note right of User
  Roles are string constants (no enum).
  Passwords and PINs are stored as BCrypt hashes.
  PIN: 4-6 numeric digits. No lockout after failed attempts.
end note
note bottom of DeleteAccountCommand
  Handled by UserCommandService in one transaction:
  deletes Journal, Habits and Chat data of the user.
  Notifications, Subscriptions and Support data are NOT deleted.
end note
@enduml
