@startuml HabitsWellness_DomainLayer_ClassDiagram
!include style.iuml
title MindFlow - Habits & Wellness - Domain Layer Class Diagram

interface IAuditableEntity {
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
interface "IBaseRepository<TEntity>" as IBaseRepository {
  +AddAsync(entity: TEntity, ct: CancellationToken) : Task
  +FindByIdAsync(id: int, ct: CancellationToken) : Task<TEntity?>
  +Update(entity: TEntity) : void
  +Remove(entity: TEntity) : void
  +ListAsync(ct: CancellationToken) : Task<IEnumerable<TEntity>>
}
enum HabitFrequency {
  Daily
  Weekly
  Monthly
}
enum HabitStatus {
  Pending
  Completed
  PausedByAi
}
class Habit <<Aggregate Root>> {
  -Id : int
  -UserId : int
  -Name : string
  -Category : string
  -Frequency : HabitFrequency
  -Streak : int
  -Status : HabitStatus
  -PausedByAi : bool
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
  -DeletedAt : DateTimeOffset?
  +MarkCompleted() : void
  +MarkPending() : void
  +SetStreak(streak: int) : void
  +PauseByAi() : void
  +Resume() : void
  +UpdateDetails(name: string, category: string, frequency: HabitFrequency) : void
  +UpdateFull(name, category, frequency, streak, status, pausedByAi) : void
  +SoftDelete() : void
}
class HabitCompletionLog <<Entity>> {
  -Id : int
  -HabitId : int
  -HabitName : string
  -Category : string
  -Date : DateTime
  -Completed : bool
  -CompletedAt : DateTime?
  -CreatedAt : DateTimeOffset
  +UpdateDetails(habitName: string, category: string, completed: bool, completedAt: DateTime?) : void
}
class CachedHabitSuggestion <<Entity>> {
  +Id : int
  +UserId : int
  +SuggestionsJson : string
  +GeneratedAt : DateTimeOffset
}
class WellnessExercise <<Aggregate Root>> {
  +Id : int
  +Type : string
  +Name : string
  +Description : string
  +DurationSeconds : int
  +InhaleSeconds : int?
  +HoldSeconds : int?
  +ExhaleSeconds : int?
  +HoldAfterExhaleSeconds : int?
  +Cycles : int?
  +AudioUrl : string?
  +IsActive : bool
  +SortOrder : int
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
enum HabitsError {
  HabitNotFound
  HabitCreationFailed
  HabitUpdateFailed
  HabitDeletionFailed
  HabitLogNotFound
  HabitLogCreationFailed
  HabitLogUpdateFailed
  HabitLogDeletionFailed
  InvalidHabitFrequency
  InvalidHabitStatus
  InvalidHabitCategory
  UserIdMismatch
}
interface IHabitRepository {
  +FindByUserIdAsync(userId: int) : Task<IEnumerable<Habit>>
  +FindByIdAndUserIdAsync(id: int, userId: int) : Task<Habit?>
}
interface IHabitCompletionLogRepository {
  +FindByHabitIdAsync(habitId: int) : Task<IEnumerable<HabitCompletionLog>>
  +FindByUserIdAsync(userId: int) : Task<IEnumerable<HabitCompletionLog>>
}

Habit ..|> IAuditableEntity : implements
WellnessExercise ..|> IAuditableEntity : implements
IHabitRepository --|> IBaseRepository : extends
IHabitCompletionLogRepository --|> IBaseRepository : extends
Habit "1" *-- "0..*" HabitCompletionLog : "is completed through >"
Habit "*" --> "1" HabitFrequency : "repeats with >"
Habit "*" --> "1" HabitStatus : "is in >"
IHabitRepository ..> Habit : "stores >"
IHabitCompletionLogRepository ..> HabitCompletionLog : "stores >"

note right of Habit
  Status and PausedByAi coexist and are kept in sync by
  PauseByAi() and Resume(). UpdateFull() is not used.
  The delete flow removes the row (physical delete) even
  though DeletedAt and SoftDelete() exist.
end note
note bottom of CachedHabitSuggestion
  One row per user (unique UserId). AI suggestions
  are reused for 24 hours.
end note
@enduml
