@startuml Journal_DatabaseDiagram
!include style.iuml
skinparam linetype ortho
title MindFlow - Journal - Database Diagram (MySQL 8)

entity "journal_entries" as journal_entries {
  * id : int <<PK>>
  --
  * user_id : int <<logical FK users.id>>
  client_id : varchar(64), nullable
  * date : datetime(6) <<DateOnly in code>>
  * title : longtext
  * content : longtext <<AES-256 encrypted>>
  * sentiment : longtext
  * category : longtext
  * has_preview : boolean
  ai_response : text, nullable
  created_at : datetime, nullable
  updated_at : datetime, nullable
  deleted_at : datetime, nullable <<soft delete>>
  --
  UNIQUE (user_id, client_id)
  INDEX (user_id), INDEX (user_id, date)
}
entity "tags" as tags {
  * id : int <<PK>>
  --
  user_id : int, nullable <<logical, no constraint>>
  * name : longtext
}
entity "entry_tags" as entry_tags {
  * id : int <<PK>>
  --
  * entry_id : int <<FK ON DELETE CASCADE>>
  * tag_id : int <<FK ON DELETE CASCADE>>
  --
  UNIQUE (entry_id, tag_id)
}
entity "media" as media {
  * id : int <<PK>>
  --
  * entry_id : int <<FK ON DELETE CASCADE>>
  * type : longtext
  * url : longtext
  created_at : datetime, nullable
  updated_at : datetime, nullable
}
entity "journal_search_tokens" as journal_search_tokens {
  * id : int <<PK>>
  --
  * entry_id : int <<FK ON DELETE CASCADE>>
  * user_id : int <<logical FK users.id>>
  * token_hash : varchar(255) <<hash>>
  --
  INDEX (user_id, token_hash), INDEX (entry_id)
}
journal_entries ||--o{ entry_tags : "is labelled by"
tags ||--o{ entry_tags : "labels"
journal_entries ||--o{ media : "has"
journal_entries ||--o{ journal_search_tokens : "is indexed by"
@enduml
