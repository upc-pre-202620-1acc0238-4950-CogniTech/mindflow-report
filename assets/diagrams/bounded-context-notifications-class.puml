@startuml Notifications_DomainLayer_ClassDiagram
!include style.iuml
title MindFlow - Notifications - Domain Layer Class Diagram

interface IAuditableEntity {
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
class Notification <<Aggregate Root>> {
  +Id : int
  +UserId : int
  +Type : string = "general"
  +Title : string
  +Body : string
  +ReadAt : DateTimeOffset?
  +CreatedAt : DateTimeOffset?
  +UpdatedAt : DateTimeOffset?
}
interface INotificationService <<Application port>> {
  +CreateAsync(userId: int, type: string, title: string, body: string, ct: CancellationToken) : Task
}
class NotificationService <<Application Service>> {
  -db : AppDbContext
  -email : IEmailService
  +CreateAsync(userId: int, type: string, title: string, body: string, ct: CancellationToken) : Task
}
interface IEmailService <<IAM>> {
  +SendNotificationAsync(...) : Task
}
class DeviceToken <<planned>> {
  +Id : int
  +UserId : int
  +Token : string
  +Platform : string
}
class FcmNotificationService <<planned>> {
  +SendPushAsync(...) : Task
}

Notification ..|> IAuditableEntity : implements
NotificationService ..|> INotificationService : implements
NotificationService ..> Notification : "creates 0..* >"
NotificationService ..> IEmailService : "sends email through >"
FcmNotificationService ..> DeviceToken : "would read >"

note right of Notification
  Type is a free string (the only value in use is "support").
  A notification is unread while ReadAt is null.
  Only the Support context creates notifications today.
end note
note bottom of DeviceToken
  Grey classes are planned and not implemented:
  there is no push delivery and no reminder job.
end note
@enduml
